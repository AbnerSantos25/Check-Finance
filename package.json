{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:ssr": "vite-react-ssg dev --host",
    "dev:api": "npm run build && wrangler dev",
    "build": "vite-react-ssg build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
